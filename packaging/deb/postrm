#!/bin/sh
# The unit file is gone by now; tell systemd so, and clear the unit's residual
# state. A failed macfand left in systemd's books after the package is removed
# is litter, and it is litter that shows up as a red line in `systemctl status`
# on a machine that no longer has macfand on it.
set -e

case "$1" in
    remove)
        # The enable symlinks in /etc outlive a remove, and would point at a
        # unit file that is no longer there. Masking covers that gap; postinst's
        # unmask lifts it again if the package comes back.
        deb-systemd-helper mask macfand.service >/dev/null || true
        ;;
    purge)
        # Only purge discards the operator's enable state and the symlinks
        # behind it. A remove that is reinstalled later gets both back.
        deb-systemd-helper purge macfand.service >/dev/null || true
        deb-systemd-helper unmask macfand.service >/dev/null || true
        ;;
    *) exit 0 ;;
esac

[ -d /run/systemd/system ] || exit 0
systemctl daemon-reload || true
systemctl reset-failed macfand.service || true

exit 0
